def cleanupResources() {
    if (params.PROJECT && env.CURRENT_COLOR && env.KUBE_NAMESPACE && env.SERVICE_NAME) {
        def releaseName = "2060-${params.PROJECT}-${env.CURRENT_COLOR}"
        echo "🧹 Uninstalling Helm release: ${releaseName}"
        sh "helm uninstall ${releaseName} --namespace=${env.KUBE_NAMESPACE}"
    }

    if (env.CURRENT_COLOR == 'green') {
        echo "🗑️ Deleting PVCs for current color: green"
        sh "kubectl delete pvc --namespace=${env.KUBE_NAMESPACE} -l app=${env.SERVICE_NAME},color=${env.CURRENT_COLOR}"
    }

    if (env.PREVIOUS_COLOR && env.PREVIOUS_COLOR != 'none') {
        echo "🔄 Restoring service ${env.SERVICE_NAME} to previous color: ${env.PREVIOUS_COLOR}"
        sh """
            kubectl patch service ${env.SERVICE_NAME} -n ${env.KUBE_NAMESPACE} --type='merge' -p '{"spec": {"selector": {"color": "${env.PREVIOUS_COLOR}"}}}'
        """
    }
}

pipeline {
    agent any
    parameters {
        string(name: 'PROJECT', defaultValue: '', description: 'Project to deploy (from deployments directory)')
        string(name: 'VERSION', defaultValue: '', description: 'Project to deploy (from deployments directory)')
    }
    environment {
        CHARTS_DIR = "deployments"
    }
   
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', 
                    credentialsId: 'dc03c6a6-a688-4ed1-8cd3-00b9fce9af1f', 
                    url: 'https://github.com/2060-io/unic.id-deploy.git'
            }
        }

        stage('Validate Project Parameter') {
            steps {
                script {
                    if (!params.PROJECT) {
                        error "PROJECT parameter must be specified"
                    }
                    
                    // Verify project directory exists
                    def projectExists = fileExists("${CHARTS_DIR}/${params.PROJECT}")
                    if (!projectExists) {
                        error "Project '${params.PROJECT}' not found in ${CHARTS_DIR} directory"
                    }
                    
                    echo "Deploying project: ${params.PROJECT}"
                }
            }
        }

        stage('Extract Service Name and Namespace from Helm') {
            steps {
                script {
                    def chartPath = "${CHARTS_DIR}/${params.PROJECT}"
                    def extractValue = { field ->
                        sh(
                            script: "helm template temp-release ${chartPath} | awk '/^kind: Service\$/ {found=1} found && /${field}:/ {print \$2; found=0}'",
                            returnStdout: true
                        ).trim()
                    }
                    env.SERVICE_NAME = extractValue("name")
                    env.KUBE_NAMESPACE = extractValue("namespace")
                    if (!env.SERVICE_NAME && !env.KUBE_NAMESPACE) {
                        error "Failed to extract service name from Helm values"
                    }
                    echo "Service name extracted: ${env.SERVICE_NAME}"
                }
            }
        }

        stage('Detect Current Deployment') {
            when {
                expression { return env.SERVICE_NAME && env.KUBE_NAMESPACE }
            }
            steps {
                script {
                    def currentColor = sh(
                        script: "kubectl get service ${env.SERVICE_NAME} -n ${KUBE_NAMESPACE} -o=jsonpath='{.spec.selector.color}' || echo 'none'",
                        returnStdout: true
                    ).trim()
                    
                    env.PREVIOUS_COLOR = currentColor == 'none' ? 'none' : currentColor
                    env.CURRENT_COLOR = currentColor == 'blue' ? 'green' : 'blue'
                    echo "Current deployment is ${env.PREVIOUS_COLOR}, switching to ${env.CURRENT_COLOR}"
                }
            }
        }

        stage('Install New Deployment') {
            when {
                expression { return env.CURRENT_COLOR && env.KUBE_NAMESPACE }
            }
            steps {
                script {
                    def serviceExists = sh(
                        script: "kubectl get service ${env.SERVICE_NAME} -n ${env.KUBE_NAMESPACE} --ignore-not-found --no-headers",
                        returnStdout: true
                    ).trim()

                    def isFirstDeployment = serviceExists ? "false" : "true"
                    echo "Installing ${params.PROJECT} on ${env.CURRENT_COLOR} (first deployment: ${isFirstDeployment})..."
                    def chartPath = "${CHARTS_DIR}/${params.PROJECT}"
                    sh """
                        helm upgrade --install 2060-${params.PROJECT}-${env.CURRENT_COLOR} ${chartPath} \
                        --set image.tag=${params.VERSION} \
                        --set deployment.color=${env.CURRENT_COLOR} \
                        --set deployment.first=${isFirstDeployment} \
                        --namespace ${env.KUBE_NAMESPACE} \
                        --wait
                    """
                }
            }
        }

        stage('Switch Traffic') {
            when {
                expression { return env.CURRENT_COLOR && currentBuild.result != 'UNSTABLE' && currentBuild.result != 'FAILURE' }
            }
            steps {
                script {
                    def serviceExists = sh(
                        script: "kubectl get service ${env.SERVICE_NAME} -n ${env.KUBE_NAMESPACE} --ignore-not-found --no-headers",
                        returnStdout: true
                    ).trim()
                    if (serviceExists) {
                        echo "Updating service ${env.SERVICE_NAME} to point to ${env.CURRENT_COLOR}..."
                        sh """
                            kubectl patch service ${env.SERVICE_NAME} -n ${env.KUBE_NAMESPACE} --type='merge' -p '{"spec": {"selector": {"color": "${env.CURRENT_COLOR}"}}}'
                        """
                    } else {
                        echo "Service ${env.SERVICE_NAME} does not exist. Skipping update."
                    }
                }
            }
        }

       stage('Validation') {
            when {
                expression { return env.CURRENT_COLOR }
            }
            steps {
                script {
                    def approvalMessage = """
                        New deployment is ready for testing on the ${env.CURRENT_COLOR} environment.
                        Please verify the new deployment and click "Approve and Switch Traffic" to proceed.
                        
                        Service: ${env.SERVICE_NAME}
                        Namespace: ${env.KUBE_NAMESPACE}
                        New Color: ${env.CURRENT_COLOR}
                        Previous Color: ${env.PREVIOUS_COLOR}
                        
                        If you cancel this input, the deployment will be rolled back and all created resources will be removed.
                    """.stripIndent()
                    
                    try {
                        timeout(time: 1, unit: 'HOURS') {
                            input message: approvalMessage,
                                ok: "Approve and Switch Traffic"
                        }
                    } catch (Exception e) {
                        if (e instanceof hudson.AbortException) {
                            echo "🚨 Deployment approval was cancelled. Aborting pipeline gracefully..."
                            currentBuild.result = 'ABORTED'
                        } else if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
                            echo "🚨 Deployment was rejected. Marking pipeline as UNSTABLE..."
                            currentBuild.result = 'UNSTABLE'
                        } else {
                            echo "🚨 Deployment approval was rejected or timed out. Rolling back..."
                            currentBuild.result = 'UNSTABLE'
                        }

                    }
                }
            }
        }

        stage('Update Blue') {
            when {
                expression { return env.PREVIOUS_COLOR && env.PREVIOUS_COLOR != 'none' && currentBuild.result != 'UNSTABLE' && currentBuild.result != 'FAILURE'  }
            }
            steps {
                script {
                    echo "Updating ${env.PREVIOUS_COLOR} version on ${params.PROJECT}..."
                    def chartPath = "${CHARTS_DIR}/${params.PROJECT}"
                    sh """
                        helm upgrade --install 2060-${params.PROJECT}-${env.PREVIOUS_COLOR} ${chartPath} \
                        --set image.tag=${params.VERSION} \
                        --set deployment.color=${env.PREVIOUS_COLOR} \
                        --namespace ${env.KUBE_NAMESPACE} \
                        --wait
                    """
                    cleanupResources()
                }
            }
        }
    }
    
    post {
        failure {
            echo "🚨 Deployment failed or was rejected! Cleaning up created resources..."
            script {
                cleanupResources()
            }
        }
        unstable {
            echo "⚠️ Deployment is unstable. Cleaning up resources..."
            script {
                cleanupResources()
            }
        }
    }
}
